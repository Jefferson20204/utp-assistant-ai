# Copia este archivo a .env y completa tus credenciales locales.
# No subas el archivo .env al repositorio.

# API de Gemini / Google AI Studio
GEMINI_API_KEY=tu_api_key_aqui

# Jira (opcional, si usas autenticación con Jira)
JIRA_SERVER_URL=https://tu-dominio.atlassian.net
JIRA_USER_EMAIL=tu_email@empresa.com
JIRA_API_TOKEN=tu_token_jira

# CRM / otros secretos locales
CRM_API_KEY=tu_api_key_crm
